# Database (local docker:up uses host ports 5434 / 6381)
DATABASE_URL=postgresql://store:store@localhost:5434/online_store?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# API
API_PORT=3001
API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:8080
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_CUSTOMER_SECRET=change-me-customer-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
CUSTOMER_OTP_PEPPER=change-me-otp-pepper-min-32-chars!!!!

# Customer OAuth (optional — buttons hide when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OAUTH_REDIRECT_BASE=http://localhost:3001

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Store Owner

# Stripe (use real test keys locally, or leave xxx to enable mock checkout in non-prod)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_TAX_ENABLED=false
# Publishable key for Express Checkout Element (Link / PayPal / Apple Pay / Google Pay).
# Leave empty to hide the express row; wallets need Dashboard methods + domain registration.
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Mock checkout is auto-disabled when NODE_ENV=production
ALLOW_MOCK_PAYMENTS=true

# Media (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=store-media
S3_PUBLIC_URL=http://localhost:9000/store-media

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=store@example.com
# Production: configure SPF/DKIM/DMARC on the EMAIL_FROM domain.

# Cloudflare Turnstile (newsletter anti-bot)
# Test keys always pass: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Store
STORE_NAME=Online Store
STORE_DEFAULT_LOCALE=en
STORE_DEFAULT_CURRENCY=EUR
STORE_LOCALES=en,de
STOREFRONT_URL=http://localhost:4321


# Analytics (storefront reads PUBLIC_* names)
# Scripts ship disabled (type=text/plain) until cookie consent is accepted.
PUBLIC_ANALYTICS_PROVIDER=plausible
PUBLIC_PLAUSIBLE_DOMAIN=localhost
PUBLIC_GA4_MEASUREMENT_ID=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature flags
ENABLE_REVIEWS=true
ENABLE_CUSTOMER_ACCOUNTS=true
ENABLE_MULTI_CURRENCY=true

# Storefront
PUBLIC_STORE_URL=http://localhost:4321

# --- Production Compose overrides (docker/docker-compose.prod.yml) ---
# NODE_ENV=production
# POSTGRES_USER=store
# POSTGRES_PASSWORD=<strong-password>
# POSTGRES_DB=online_store
# DATABASE_URL=postgresql://store:<strong-password>@postgres:5432/online_store?schema=public
# REDIS_URL=redis://redis:6379
# API_PORT=3000
# COOKIE_SECURE=true
# ALLOW_MOCK_PAYMENTS=false
# CORS_ORIGINS=https://store.example.com,https://admin.example.com
# PUBLIC_API_URL=https://api.example.com
