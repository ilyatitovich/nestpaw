# Database
DATABASE_URL=postgresql://store:store@localhost:5434/online_store?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# API
API_PORT=3001
API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:8080
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Store Owner

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_TAX_ENABLED=false

# Media (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=store-media
S3_PUBLIC_URL=http://localhost:9000/store-media

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=store@example.com

# Store
STORE_NAME=Online Store
STORE_DEFAULT_LOCALE=en
STORE_DEFAULT_CURRENCY=EUR
STORE_LOCALES=en,de

# Analytics
ANALYTICS_PROVIDER=plausible
PLAUSIBLE_DOMAIN=
GA4_MEASUREMENT_ID=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# Feature flags
ENABLE_REVIEWS=true
ENABLE_CUSTOMER_ACCOUNTS=true
ENABLE_MULTI_CURRENCY=true

# Storefront
PUBLIC_STORE_URL=http://localhost:4321
