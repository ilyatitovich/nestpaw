---
import { type Locale, locales, localizePath, storeName, t } from "../i18n/ui";

interface Props {
  locale: Locale | string;
}

const { locale } = Astro.props;

const activeLocale = (
  locales.includes(locale as Locale) ? locale : "en"
) as Locale;

const year = new Date().getFullYear();
const email = "hello@nestpaw.example";
const phone = "+49 30 1208 4400";
const phoneHref = "tel:+493012084400";

const locations = [
  "Berlin",
  "München",
  "Hamburg",
  "Köln",
  "Frankfurt",
  "Wien",
  "Stuttgart",
] as const;

const serviceLinks = [
  { href: localizePath(activeLocale, "/pages/about"), label: t(activeLocale, "footer.about") },
  { href: localizePath(activeLocale, "/pages/shipping"), label: t(activeLocale, "footer.shipping") },
  { href: localizePath(activeLocale, "/pages/returns"), label: t(activeLocale, "footer.returns") },
  { href: localizePath(activeLocale, "/pages/widerruf"), label: t(activeLocale, "footer.widerruf") },
  { href: localizePath(activeLocale, "/pages/privacy"), label: t(activeLocale, "footer.privacy") },
  { href: localizePath(activeLocale, "/pages/cookies"), label: t(activeLocale, "footer.cookies") },
  { href: localizePath(activeLocale, "/pages/terms"), label: t(activeLocale, "footer.terms") },
  { href: localizePath(activeLocale, "/pages/impressum"), label: t(activeLocale, "footer.impressum") },
  { href: localizePath(activeLocale, "/pages/contact"), label: t(activeLocale, "footer.contact") },
] as const;

const payments = [
  "Visa",
  "Mastercard",
  "American Express",
  "Klarna",
  "PayPal",
] as const;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand-col">
        <a class="site-footer__brand" href={localizePath(activeLocale, "/")}>
          {storeName}
        </a>
        <p class="site-footer__tagline">{t(activeLocale, "footer.tagline")}</p>
        <ul class="site-footer__social" role="list">
          <li>
            <a
              class="site-footer__social-link"
              href="https://www.facebook.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t(activeLocale, "footer.socialFacebook")}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h2.6l.4-3H14V9z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              class="site-footer__social-link"
              href="https://www.instagram.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t(activeLocale, "footer.socialInstagram")}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2Zm0 7.9A3.1 3.1 0 1 1 12 8.9a3.1 3.1 0 0 1 0 6.2Zm5.1-8.2a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM12 4.5c-2 0-2.3 0-3.1.1a4.6 4.6 0 0 0-3.3 3.3c-.1.8-.1 1-.1 3.1s0 2.3.1 3.1a4.6 4.6 0 0 0 3.3 3.3c.8.1 1 .1 3.1.1s2.3 0 3.1-.1a4.6 4.6 0 0 0 3.3-3.3c.1-.8.1-1 .1-3.1s0-2.3-.1-3.1a4.6 4.6 0 0 0-3.3-3.3c-.8-.1-1-.1-3.1-.1Zm0 1.5c2 0 2.2 0 3 .1a3.1 3.1 0 0 1 2.3 2.3c.1.8.1 1 .1 3s0 2.2-.1 3a3.1 3.1 0 0 1-2.3 2.3c-.8.1-1 .1-3 .1s-2.2 0-3-.1a3.1 3.1 0 0 1-2.3-2.3c-.1-.8-.1-1-.1-3s0-2.2.1-3A3.1 3.1 0 0 1 9 6.1c.8-.1 1-.1 3-.1Z"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 id="footer-locations-heading" class="site-footer__heading">
          {t(activeLocale, "footer.locations")}
        </h2>
        <ul class="site-footer__list" role="list">
          {
            locations.map((city) => (
              <li>{city}</li>
            ))
          }
        </ul>
      </div>

      <nav class="site-footer__col" aria-labelledby="footer-service-heading">
        <h2 id="footer-service-heading" class="site-footer__heading">
          {t(activeLocale, "footer.service")}
        </h2>
        <ul class="site-footer__list">
          {
            serviceLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 id="footer-contact-heading" class="site-footer__heading">
          {t(activeLocale, "footer.contactHeading")}
        </h2>
        <address class="site-footer__contact">
          <p class="site-footer__contact-name">{t(activeLocale, "footer.contactName")}</p>
          <a href={`mailto:${email}`}>{email}</a>
          <a href={phoneHref}>{phone}</a>
          <p>{t(activeLocale, "footer.hoursDays")}</p>
          <p>{t(activeLocale, "footer.hoursTime")}</p>
        </address>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__disclaimer">{t(activeLocale, "footer.disclaimer")}</p>
      <ul
        class="site-footer__payments"
        role="list"
        aria-label={t(activeLocale, "footer.payments")}
      >
        {
          payments.map((method) => (
            <li>
              <span class="site-footer__payment">{method}</span>
            </li>
          ))
        }
      </ul>
      <p class="site-footer__copy">
        {t(activeLocale, "footer.copyright").replace("{year}", String(year))}
      </p>
    </div>
  </div>
</footer>
