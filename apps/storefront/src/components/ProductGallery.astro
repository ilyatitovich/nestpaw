---
import CloseIcon from "./icons/CloseIcon.astro";
import HeartIcon from "./icons/HeartIcon.astro";

interface MediaItem {
  url: string;
  alt: string;
}

interface Props {
  media: MediaItem[];
  title: string;
  productId: string;
  salePercent?: number | null;
  saleLabel: string;
  wishlistAddLabel: string;
  wishlistRemoveLabel: string;
  prevLabel: string;
  nextLabel: string;
  gotoLabel: string;
  galleryLabel: string;
  closeLabel: string;
}

const {
  media,
  title,
  productId,
  salePercent,
  saleLabel,
  wishlistAddLabel,
  wishlistRemoveLabel,
  prevLabel,
  nextLabel,
  gotoLabel,
  galleryLabel,
  closeLabel,
} = Astro.props;

const hasMedia = media.length > 0;
const hasMultiple = media.length > 1;

function isVideoUrl(url: string) {
  return /\.(mp4|webm|ogg)(\?|$)/i.test(url);
}
---

{
  hasMedia ? (
    <div
      class:list={["pdp__gallery", hasMultiple && "pdp__gallery--multi"]}
      data-pdp-gallery
      role={hasMultiple ? "region" : undefined}
      aria-roledescription={hasMultiple ? "carousel" : undefined}
      aria-label={hasMultiple ? galleryLabel : undefined}
    >
      {hasMultiple ? (
        <div class="pdp__thumbs" data-pdp-thumbs>
          {media.map((item, index) => (
            <button
              type="button"
              class:list={[
                "pdp__thumb",
                index === 0 && "is-active",
                isVideoUrl(item.url) && "pdp__thumb--video",
              ]}
              aria-label={gotoLabel.replace("{n}", String(index + 1))}
              aria-current={index === 0 ? "true" : undefined}
              data-pdp-thumb={index}
            >
              {isVideoUrl(item.url) ? (
                <video
                  src={item.url}
                  muted
                  playsinline
                  preload="metadata"
                  aria-hidden="true"
                />
              ) : (
                <img
                  src={item.url}
                  alt=""
                  width="88"
                  height="88"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </button>
          ))}
        </div>
      ) : null}

      <div class="pdp__stage">
        <div class="pdp__media pdp__media--zoomable" data-pdp-open>
          {salePercent ? (
            <div class="pdp__badges">
              <span class="pdp__badge">{saleLabel}</span>
              <span class="pdp__badge">{salePercent}%</span>
            </div>
          ) : null}
          <button
            type="button"
            class="pdp__wishlist"
            data-wishlist-toggle
            data-product-id={productId}
            data-label-add={wishlistAddLabel}
            data-label-remove={wishlistRemoveLabel}
            aria-pressed="false"
            aria-label={wishlistAddLabel}
          >
            <HeartIcon class="pdp__wishlist-icon" />
          </button>

          {hasMultiple ? (
            <>
              <div class="pdp__viewport" data-pdp-viewport>
                <div class="pdp__slides">
                  {media.map((item, index) => (
                    <div
                      class="pdp__slide"
                      role="group"
                      aria-roledescription="slide"
                      aria-label={`${index + 1} / ${media.length}`}
                    >
                      {isVideoUrl(item.url) ? (
                        <video
                          class="pdp__video"
                          src={item.url}
                          muted
                          loop
                          playsinline
                          preload={index === 0 ? "auto" : "metadata"}
                          aria-label={item.alt || title}
                        />
                      ) : (
                        <img
                          src={item.url}
                          alt={item.alt || title}
                          width="800"
                          height="800"
                          fetchpriority={index === 0 ? "high" : "low"}
                          loading={index === 0 ? "eager" : "lazy"}
                          decoding={index === 0 ? "sync" : "async"}
                        />
                      )}
                    </div>
                  ))}
                </div>
              </div>

              <button
                type="button"
                class="pdp__nav pdp__nav--prev"
                aria-label={prevLabel}
                data-pdp-prev
              >
                <svg
                  class="pdp__nav-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </button>
              <button
                type="button"
                class="pdp__nav pdp__nav--next"
                aria-label={nextLabel}
                data-pdp-next
              >
                <svg
                  class="pdp__nav-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </button>

              <div class="pdp__dots" data-pdp-dots>
                {media.map((_, index) => (
                  <button
                    type="button"
                    class:list={["pdp__dot", index === 0 && "is-active"]}
                    aria-label={gotoLabel.replace("{n}", String(index + 1))}
                    aria-current={index === 0 ? "true" : undefined}
                    data-pdp-dot={index}
                  />
                ))}
              </div>
            </>
          ) : isVideoUrl(media[0].url) ? (
            <video
              class="pdp__video"
              src={media[0].url}
              muted
              loop
              playsinline
              autoplay
              preload="auto"
              aria-label={media[0].alt || title}
            />
          ) : (
            <img
              src={media[0].url}
              alt={media[0].alt || title}
              width="800"
              height="800"
              fetchpriority="high"
            />
          )}

        </div>
      </div>

      <dialog
        class="pdp-lightbox"
        data-pdp-lightbox
        closedby="any"
        aria-label={galleryLabel}
      >
        <form method="dialog" class="pdp-lightbox__toolbar">
          <button
            type="submit"
            class="pdp-lightbox__close"
            autofocus
            aria-label={closeLabel}
          >
            <CloseIcon class="pdp-lightbox__close-icon" />
          </button>
        </form>

        <div
          class:list={[
            "pdp__gallery",
            "pdp-lightbox__gallery",
            hasMultiple && "pdp__gallery--multi",
          ]}
          data-pdp-lightbox-gallery
        >
          {hasMultiple ? (
            <div class="pdp__thumbs" data-pdp-thumbs>
              {media.map((item, index) => (
                <button
                  type="button"
                  class:list={[
                    "pdp__thumb",
                    index === 0 && "is-active",
                    isVideoUrl(item.url) && "pdp__thumb--video",
                  ]}
                  aria-label={gotoLabel.replace("{n}", String(index + 1))}
                  aria-current={index === 0 ? "true" : undefined}
                  data-pdp-thumb={index}
                >
                  {isVideoUrl(item.url) ? (
                    <video
                      src={item.url}
                      muted
                      playsinline
                      preload="metadata"
                      aria-hidden="true"
                    />
                  ) : (
                    <img
                      src={item.url}
                      alt=""
                      width="88"
                      height="88"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </button>
              ))}
            </div>
          ) : null}

          <div class="pdp__stage">
            <div class="pdp__media pdp-lightbox__media">
              {hasMultiple ? (
                <>
                  <div class="pdp__viewport" data-pdp-viewport>
                    <div class="pdp__slides">
                      {media.map((item, index) => (
                        <div
                          class="pdp__slide"
                          role="group"
                          aria-roledescription="slide"
                          aria-label={`${index + 1} / ${media.length}`}
                        >
                          {isVideoUrl(item.url) ? (
                            <video
                              class="pdp__video"
                              src={item.url}
                              muted
                              loop
                              playsinline
                              preload="metadata"
                              aria-label={item.alt || title}
                            />
                          ) : (
                            <img
                              src={item.url}
                              alt={item.alt || title}
                              width="1200"
                              height="1200"
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                        </div>
                      ))}
                    </div>
                  </div>

                  <button
                    type="button"
                    class="pdp__nav pdp__nav--prev"
                    aria-label={prevLabel}
                    data-pdp-prev
                  >
                    <svg
                      class="pdp__nav-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 18l-6-6 6-6" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="pdp__nav pdp__nav--next"
                    aria-label={nextLabel}
                    data-pdp-next
                  >
                    <svg
                      class="pdp__nav-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M9 18l6-6-6-6" />
                    </svg>
                  </button>

                  <div class="pdp__dots" data-pdp-dots>
                    {media.map((_, index) => (
                      <button
                        type="button"
                        class:list={["pdp__dot", index === 0 && "is-active"]}
                        aria-label={gotoLabel.replace("{n}", String(index + 1))}
                        aria-current={index === 0 ? "true" : undefined}
                        data-pdp-dot={index}
                      />
                    ))}
                  </div>
                </>
              ) : isVideoUrl(media[0].url) ? (
                <video
                  class="pdp__video"
                  src={media[0].url}
                  muted
                  loop
                  playsinline
                  autoplay
                  preload="auto"
                  aria-label={media[0].alt || title}
                />
              ) : (
                <img
                  src={media[0].url}
                  alt={media[0].alt || title}
                  width="1200"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          </div>
        </div>
      </dialog>
    </div>
  ) : null
}

{
  hasMedia ? (
    <script>
      import EmblaCarousel from "embla-carousel";

      type GalleryEmbla = ReturnType<typeof EmblaCarousel>;

      function wireCarousel(root: HTMLElement): GalleryEmbla | null {
        // Only the direct stage — never the nested lightbox copy inside <dialog>.
        const stageNode = root.querySelector(":scope > .pdp__stage");
        if (!(stageNode instanceof HTMLElement)) return null;
        const stage: HTMLElement = stageNode;
        const viewport = stage.querySelector("[data-pdp-viewport]");
        if (!(viewport instanceof HTMLElement)) return null;
        const thumbsRoot = root.querySelector(":scope > .pdp__thumbs");

        const emblaApi = EmblaCarousel(viewport, {
          loop: true,
          align: "start",
          duration: 22,
        });

        const prev = stage.querySelector<HTMLButtonElement>("[data-pdp-prev]");
        const next = stage.querySelector<HTMLButtonElement>("[data-pdp-next]");
        const dots = [
          ...stage.querySelectorAll<HTMLButtonElement>("[data-pdp-dot]"),
        ];
        const thumbs = thumbsRoot
          ? [
              ...thumbsRoot.querySelectorAll<HTMLButtonElement>(
                "[data-pdp-thumb]",
              ),
            ]
          : [];

        function syncUi() {
          const selected = emblaApi.selectedScrollSnap();
          const slides = [
            ...stage.querySelectorAll<HTMLElement>(".pdp__slide"),
          ];

          for (const [index, dot] of dots.entries()) {
            const active = index === selected;
            dot.classList.toggle("is-active", active);
            if (active) dot.setAttribute("aria-current", "true");
            else dot.removeAttribute("aria-current");
          }

          for (const [index, thumb] of thumbs.entries()) {
            const active = index === selected;
            thumb.classList.toggle("is-active", active);
            if (active) {
              thumb.setAttribute("aria-current", "true");
              thumb.scrollIntoView({
                block: "nearest",
                inline: "nearest",
                behavior: "smooth",
              });
            } else {
              thumb.removeAttribute("aria-current");
            }
          }

          for (const [index, slide] of slides.entries()) {
            const video = slide.querySelector("video");
            if (!(video instanceof HTMLVideoElement)) continue;
            if (index === selected) {
              void video.play().catch(() => {});
            } else {
              video.pause();
              video.currentTime = 0;
            }
          }
        }

        prev?.addEventListener("click", (e) => {
          e.stopPropagation();
          emblaApi.scrollPrev();
        });
        next?.addEventListener("click", (e) => {
          e.stopPropagation();
          emblaApi.scrollNext();
        });

        for (const dot of dots) {
          dot.addEventListener("click", (e) => {
            e.stopPropagation();
            const index = Number(dot.dataset.pdpDot);
            if (Number.isFinite(index)) emblaApi.scrollTo(index);
          });
        }

        for (const thumb of thumbs) {
          thumb.addEventListener("click", () => {
            const index = Number(thumb.dataset.pdpThumb);
            if (Number.isFinite(index)) emblaApi.scrollTo(index);
          });
        }

        emblaApi.on("select", syncUi);
        emblaApi.on("reInit", syncUi);
        syncUi();
        return emblaApi;
      }

      function installClosedByFallback(dialog: HTMLDialogElement) {
        if ("closedBy" in HTMLDialogElement.prototype) return;

        let pressedOutside = false;
        const outside = (e: PointerEvent) => {
          const r = dialog.getBoundingClientRect();
          return (
            e.clientX < r.left ||
            e.clientX > r.right ||
            e.clientY < r.top ||
            e.clientY > r.bottom
          );
        };

        dialog.addEventListener("pointerdown", (e) => {
          pressedOutside = outside(e);
        });
        dialog.addEventListener("pointerup", (e) => {
          if (pressedOutside && outside(e)) dialog.close();
        });
      }

      function initProductGallery(root: HTMLElement) {
        if (root.dataset.pdpReady === "true") return;
        root.dataset.pdpReady = "true";

        const galleryEmbla = wireCarousel(root);
        const dialog = root.querySelector<HTMLDialogElement>("[data-pdp-lightbox]");
        const lightboxRoot = root.querySelector<HTMLElement>(
          "[data-pdp-lightbox-gallery]",
        );
        if (!dialog || !lightboxRoot) return;

        installClosedByFallback(dialog);

        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });

        let lightboxEmbla: GalleryEmbla | null = null;

        function ensureLightboxCarousel() {
          if (!lightboxEmbla) lightboxEmbla = wireCarousel(lightboxRoot!);
          return lightboxEmbla;
        }

        function openLightbox() {
          const index = galleryEmbla?.selectedScrollSnap() ?? 0;
          // Defer past the opening click so closedby="any" doesn't instantly dismiss.
          window.setTimeout(() => {
            dialog!.showModal();
            const lb = ensureLightboxCarousel();
            requestAnimationFrame(() => {
              lb?.reInit();
              lb?.scrollTo(index, true);
            });
          }, 0);
        }

        const openTarget = root.querySelector<HTMLElement>(
          ":scope > .pdp__stage [data-pdp-open]",
        );

        // Track drag so Embla swipes don't open the lightbox.
        let dragOrigin: { x: number; y: number } | null = null;
        let dragged = false;

        openTarget?.addEventListener(
          "pointerdown",
          (e) => {
            if (!(e.target instanceof Element) || e.target.closest("button")) {
              dragOrigin = null;
              dragged = false;
              return;
            }
            dragOrigin = { x: e.clientX, y: e.clientY };
            dragged = false;
          },
          true,
        );

        openTarget?.addEventListener(
          "pointermove",
          (e) => {
            if (!dragOrigin) return;
            if (
              Math.abs(e.clientX - dragOrigin.x) > 6 ||
              Math.abs(e.clientY - dragOrigin.y) > 6
            ) {
              dragged = true;
            }
          },
          true,
        );

        openTarget?.addEventListener(
          "click",
          (e) => {
            if (!(e.target instanceof Element) || e.target.closest("button")) {
              return;
            }
            if (dragged) return;
            e.preventDefault();
            openLightbox();
          },
          true,
        );

        dialog.addEventListener("close", () => {
          for (const video of root.querySelectorAll("video")) {
            video.pause();
          }
          const index = lightboxEmbla?.selectedScrollSnap() ?? 0;
          galleryEmbla?.scrollTo(index, true);
        });
      }

      document
        .querySelectorAll<HTMLElement>("[data-pdp-gallery]")
        .forEach(initProductGallery);
    </script>
  ) : null
}
