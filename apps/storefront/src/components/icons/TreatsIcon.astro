---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <ellipse cx="12" cy="12" rx="8" ry="4.5" transform="rotate(-35 12 12)"
  ></ellipse>
  <path d="M8.5 9.5c1.2.8 2.3 1.2 3.5 1.2s2.3-.4 3.5-1.2"></path>
</svg>
