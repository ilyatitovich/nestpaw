---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <circle cx="12" cy="12" r="3.2"></circle>
  <circle cx="12" cy="4.8" r="1.6"></circle>
  <circle cx="12" cy="19.2" r="1.6"></circle>
  <circle cx="4.8" cy="12" r="1.6"></circle>
  <circle cx="19.2" cy="12" r="1.6"></circle>
</svg>
