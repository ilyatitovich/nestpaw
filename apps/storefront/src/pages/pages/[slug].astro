---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  defaultLocale,
  type Locale,
  localizePath,
  t,
  translatedPaths,
} from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiGet } from "../../lib/api";
import { cmsPagePaths } from "../../lib/static-paths";

export function getStaticPaths() {
  return cmsPagePaths();
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const slug = Astro.params.slug!;

type Page = {
  translations: {
    locale: string;
    title: string;
    slug: string;
    body: string;
    seoDescription?: string;
  }[];
};

let page: Page | null = null;
try {
  page = await apiGet<Page>(`/pages/${locale}/${slug}`);
} catch {
  page = {
    translations: [
      {
        locale,
        title: slug === "cookies" ? "Cookie policy" : slug,
        slug,
        body:
          slug === "privacy"
            ? "We process order data to fulfill purchases."
            : slug === "cookies"
              ? "Nestpaw stores your analytics consent choice in localStorage (nestpaw-cookie-consent). Essential cookies may be used for cart and account sessions. Optional analytics (Plausible or Google Analytics 4, depending on configuration) load only after you accept. You can clear site data in your browser to reset the choice and see the banner again."
              : "We make durable goods for everyday use.",
      },
    ],
  };
}

const tr =
  page.translations.find((x) => x.locale === locale) ?? page.translations[0];

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  { label: tr?.title ?? slug },
];
---

<BaseLayout
  locale={locale}
  title={tr?.title ?? slug}
  description={tr?.seoDescription ?? tr?.body?.slice(0, 160)}
  canonicalPath={`/pages/${slug}`}
  alternates={translatedPaths("pages", page.translations)}
>
  <div class="container page-shell prose">
    <Breadcrumbs
      items={breadcrumbs}
      label={t(locale, "product.breadcrumb")}
    />
    <h1 class="section__title">{tr?.title}</h1>
    <p>{tr?.body}</p>
  </div>
</BaseLayout>
