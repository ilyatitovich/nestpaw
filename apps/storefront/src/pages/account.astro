---
import AccountClient from "../components/AccountClient";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  defaultLocale, type Locale,
  localizePath,
  storeName,
  t,
} from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { API_URL } from "../lib/api";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA";
const shopHref = localizePath(locale, "/shop");
const homeHref = localizePath(locale, "/");

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: homeHref },
  { label: t(locale, "account.login") },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, "account.login")}
  canonicalPath="/account"
  chrome="account"
>
  <div class="account-page">
    <div class="container page-shell" data-account-chrome="member" hidden inert>
      <Breadcrumbs
        items={breadcrumbs}
        label={t(locale, "product.breadcrumb")}
      />
    </div>
    <AccountClient
      client:only="react"
      apiUrl={API_URL}
      locale={locale}
      turnstileSiteKey={turnstileSiteKey}
      termsHref={localizePath(locale, "/pages/terms")}
      privacyHref={localizePath(locale, "/pages/privacy")}
      shopHref={shopHref}
      homeHref={homeHref}
      storeName={storeName}
      labels={{
        login: t(locale, "account.login"),
        orders: t(locale, "account.orders"),
        logout: t(locale, "account.logout"),
        noOrders: t(locale, "account.noOrders"),
        email: t(locale, "account.email"),
        continue: t(locale, "account.continue"),
        code: t(locale, "account.code"),
        enterCode: t(locale, "account.enterCode"),
        verify: t(locale, "account.verify"),
        resend: t(locale, "account.resend"),
        resendIn: t(locale, "account.resendIn"),
        changeEmail: t(locale, "account.changeEmail"),
        codeSentTo: t(locale, "account.codeSentTo"),
        change: t(locale, "account.change"),
        google: t(locale, "account.google"),
        apple: t(locale, "account.apple"),
        shop: t(locale, "account.shop"),
        shopUnavailable: t(locale, "account.shopUnavailable"),
        or: t(locale, "account.or"),
        signedInAs: t(locale, "account.signedInAs"),
        sendCode: t(locale, "account.sendCode"),
        codeSent: t(locale, "account.codeSent"),
        nameFirst: t(locale, "account.nameFirst"),
        nameLast: t(locale, "account.nameLast"),
        saveProfile: t(locale, "account.saveProfile"),
        profile: t(locale, "account.profile"),
        wishlist: t(locale, "account.wishlist"),
        wishlistEmpty: t(locale, "account.wishlistEmpty"),
        wishlistCount: t(locale, "account.wishlistCount"),
        wishlistLoading: t(locale, "account.wishlistLoading"),
        wishlistError: t(locale, "account.wishlistError"),
        productFrom: t(locale, "product.from"),
        productSale: t(locale, "product.sale"),
        productAdd: t(locale, "product.add"),
        productWishlist: t(locale, "product.wishlist"),
        productWishlistAdded: t(locale, "product.wishlistAdded"),
        productAddError: t(locale, "product.addError"),
        addresses: t(locale, "account.addresses"),
        noAddresses: t(locale, "account.noAddresses"),
        defaultAddress: t(locale, "account.defaultAddress"),
        emailReadonly: t(locale, "account.emailReadonly"),
        continueShopping: t(locale, "account.continueShopping"),
        sectionsNav: t(locale, "account.sectionsNav"),
        errorGeneric: t(locale, "account.errorGeneric"),
        oauthDenied: t(locale, "account.oauthDenied"),
        errorEmailRequired: t(locale, "account.errorEmailRequired"),
        errorEmailInvalid: t(locale, "account.errorEmailInvalid"),
        errorCodeRequired: t(locale, "account.errorCodeRequired"),
        errorCodeInvalid: t(locale, "account.errorCodeInvalid"),
        errorTurnstile: t(locale, "account.errorTurnstile"),
        errorRateLimit: t(locale, "account.errorRateLimit"),
        errorInvalidCode: t(locale, "account.errorInvalidCode"),
        errorNetwork: t(locale, "account.errorNetwork"),
        errorValidation: t(locale, "account.errorValidation"),
        errorNameRequired: t(locale, "account.errorNameRequired"),
        errorNameInvalid: t(locale, "account.errorNameInvalid"),
        errorAccountNotFound: t(locale, "account.errorAccountNotFound"),
        errorAccountExists: t(locale, "account.errorAccountExists"),
        termsAgreeBefore: t(locale, "account.termsAgreeBefore"),
        terms: t(locale, "account.terms"),
        termsAgreeAfter: t(locale, "account.termsAgreeAfter"),
        privacy: t(locale, "account.privacy"),
        marketingOptIn: t(locale, "account.marketingOptIn"),
        lead: t(locale, "account.lead"),
        signIn: t(locale, "account.signIn"),
        loading: t(locale, "account.loading"),
        sendingCode: t(locale, "account.sendingCode"),
        verifying: t(locale, "account.verifying"),
        saving: t(locale, "account.saving"),
        redirecting: t(locale, "account.redirecting"),
      }}
    >
      <div slot="fallback">
        <div
          class="container page-shell account-hub account-fallback account-fallback--member"
          hidden
          aria-busy="true"
        >
          <header class="account-hub__identity">
            <div class="account-hub__identity-text">
              <p class="account-hub__greeting">
                {t(locale, "account.signedInAs")}{" "}
                <strong data-account-fallback-email></strong>
              </p>
            </div>
            <button type="button" class="btn btn--ghost" disabled tabindex="-1">
              {t(locale, "account.logout")}
            </button>
          </header>
          <div class="account-tabs">
            <div
              class="account-tabs__list"
              role="tablist"
              aria-label={t(locale, "account.sectionsNav")}
            >
              <span class="account-tabs__tab is-active" role="presentation"
                >{t(locale, "account.orders")}</span
              >
              <span class="account-tabs__tab" role="presentation"
                >{t(locale, "account.profile")}</span
              >
              <span class="account-tabs__tab" role="presentation"
                >{t(locale, "account.wishlist")}</span
              >
              <span class="account-tabs__tab" role="presentation"
                >{t(locale, "account.addresses")}</span
              >
            </div>
            <div class="account-tabpanel account-section">
              <p class="account-section__empty-text" data-account-fallback-empty>
                {t(locale, "account.noOrders")}
              </p>
              <div class="order-list" data-account-fallback-orders hidden></div>
            </div>
          </div>
        </div>
        <div
          class="account-auth-shell account-fallback account-fallback--guest"
          aria-busy="true"
        >
          <div class="account-auth-shell__pane">
            <span class="account-auth-shell__brand">{storeName}</span>
            <div class="account-auth">
              <div class="account-panel">
                <div class="account-panel__intro">
                  <p class="account-panel__title">{t(locale, "account.signIn")}</p>
                  <p class="account-panel__lead">{t(locale, "account.lead")}</p>
                </div>
                <div class="account-fallback__guest-body"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </AccountClient>
    <script is:inline>
      (function () {
        try {
          var raw = sessionStorage.getItem("nestpaw-account-snapshot");
          if (!raw) return;
          var snap = JSON.parse(raw);
          if (!snap || !snap.email) return;
          document
            .querySelectorAll("[data-account-fallback-email]")
            .forEach(function (el) {
              el.textContent = snap.email;
            });
          if (Array.isArray(snap.orders) && snap.orders.length > 0) {
            var empty = document.querySelector("[data-account-fallback-empty]");
            var list = document.querySelector("[data-account-fallback-orders]");
            if (empty) empty.hidden = true;
            if (list) {
              list.hidden = false;
              list.innerHTML = snap.orders
                .map(function (order) {
                  var meta = "";
                  try {
                    meta =
                      new Date(order.createdAt).toLocaleDateString() +
                      " · " +
                      String(order.status || "");
                  } catch (err) {
                    meta = String(order.status || "");
                  }
                  return (
                    '<div class="order-row"><div><strong>#' +
                    String(order.number) +
                    '</strong><div class="order-row__meta">' +
                    meta +
                    '</div></div><div class="order-row__total"></div></div>'
                  );
                })
                .join("");
            }
          }
        } catch (e) {}
      })();
    </script>
  </div>
</BaseLayout>
