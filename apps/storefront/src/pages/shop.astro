---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProductFilters from "../components/ProductFilters";
import { defaultLocale, type Locale, localizePath, t } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { API_URL, apiGet } from "../lib/api";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

type ProductList = {
  items: {
    id: string;
    translations: { locale: string; title: string; slug: string }[];
    media: { url: string; alt: string }[];
    variants: {
      id: string;
      price: number;
      compareAtPrice?: number | null;
      option1?: string | null;
    }[];
    metafields?: { namespace: string; key: string; value: unknown }[];
  }[];
};

let products: ProductList["items"] = [];
try {
  const data = await apiGet<ProductList>(`/products?locale=${locale}&take=48`);
  products = data.items;
} catch {
  products = [];
}

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  { label: t(locale, "shop.title") },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, "shop.title")}
  description={t(locale, "home.lead")}
  canonicalPath="/shop"
>
  <div class="container page-shell">
    <Breadcrumbs
      items={breadcrumbs}
      label={t(locale, "product.breadcrumb")}
    />
    <h1 class="section__title">{t(locale, "shop.title")}</h1>
    <ProductFilters
      client:load
      locale={locale}
      apiUrl={API_URL}
      products={products}
      labels={{
        sort: t(locale, "shop.sort"),
        filterLife: t(locale, "shop.filterLife"),
        filterType: t(locale, "shop.filterType"),
        all: t(locale, "shop.all"),
        from: t(locale, "product.from"),
        sale: t(locale, "product.sale"),
        add: t(locale, "product.add"),
        wishlist: t(locale, "product.wishlist"),
        wishlistAdded: t(locale, "product.wishlistAdded"),
        addError: t(locale, "product.addError"),
      }}
    />
  </div>
</BaseLayout>
