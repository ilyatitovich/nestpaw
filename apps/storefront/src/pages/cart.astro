---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CartClient from "@/components/CartClient";
import { defaultLocale, type Locale, localizePath, t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { API_URL } from "@/lib/api";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  { label: t(locale, "cart.title") },
];
---

<BaseLayout locale={locale} title={t(locale, "cart.title")} canonicalPath="/cart">
  <div class="container page-shell">
    <Breadcrumbs
      items={breadcrumbs}
      label={t(locale, "product.breadcrumb")}
    />
    <h1 class="section__title">{t(locale, "cart.title")}</h1>
    <CartClient
      client:load
      apiUrl={API_URL}
      locale={locale}
      shopHref={localizePath(locale, "/")}
      checkoutHref={localizePath(locale, "/checkout")}
      labels={{
        empty: t(locale, "cart.empty"),
        continueShopping: t(locale, "cart.continueShopping"),
        proceedToCheckout: t(locale, "cart.proceedToCheckout"),
        discount: t(locale, "cart.discount"),
        apply: t(locale, "cart.apply"),
        remove: t(locale, "cart.remove"),
        freeShipProgress: t(locale, "cart.freeShipProgress"),
        freeShipUnlocked: t(locale, "cart.freeShipUnlocked"),
        subtotal: t(locale, "cart.subtotal"),
        discountLabel: t(locale, "cart.discountLabel"),
        total: t(locale, "cart.total"),
        qty: t(locale, "cart.qty"),
        decreaseQty: t(locale, "cart.decreaseQty"),
        increaseQty: t(locale, "cart.increaseQty"),
        taxesNote: t(locale, "cart.taxesNote"),
        discountInvalid: t(locale, "cart.discountInvalid"),
        loadError: t(locale, "cart.loadError"),
        updateError: t(locale, "cart.updateError"),
      }}
    />
  </div>
</BaseLayout>
