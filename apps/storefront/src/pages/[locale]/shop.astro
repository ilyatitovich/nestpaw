---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales, t, type Locale } from "../../i18n/ui";
import { apiGet } from "../../lib/api";
import ProductFilters from "../../components/ProductFilters";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

type ProductList = {
  items: {
    id: string;
    translations: { locale: string; title: string; slug: string }[];
    media: { url: string; alt: string }[];
    variants: { price: number }[];
    metafields?: { namespace: string; key: string; value: unknown }[];
  }[];
};

let products: ProductList["items"] = [];
try {
  const data = await apiGet<ProductList>(`/products?locale=${locale}&take=48`);
  products = data.items;
} catch {
  products = [];
}
---

<BaseLayout
  locale={locale}
  title={t(locale, "shop.title")}
  description={t(locale, "home.lead")}
  canonicalPath="/shop"
>
  <section class="section">
    <div class="container">
      <h1 class="section__title">{t(locale, "shop.title")}</h1>
      <ProductFilters
        client:load
        locale={locale}
        products={products}
        labels={{
          sort: t(locale, "shop.sort"),
          filterLife: t(locale, "shop.filterLife"),
          filterType: t(locale, "shop.filterType"),
          all: t(locale, "shop.all"),
          from: t(locale, "product.from"),
        }}
      />
    </div>
  </section>
</BaseLayout>
