---
import { type Locale, locales, localizePath } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { API_URL } from "../../../lib/api";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout locale={locale} title="Order confirmed" canonicalPath="/checkout/success">
  <div class="container section">
    <h1 class="section__title">Thank you</h1>
    <p>Your payment was received. A confirmation email is on the way.</p>
    <a class="btn btn--primary" href={localizePath(locale, "/")}>Continue shopping</a>
  </div>
  <script is:inline define:vars={{ API_URL, locale }}>
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session_id");
    const cartToken = localStorage.getItem("cart_token");

    async function clearCart() {
      if (!cartToken) return;
      try {
        await fetch(`${API_URL}/cart`, {
          method: "DELETE",
          headers: { "X-Cart-Token": cartToken },
        });
      } catch (_) {}
    }

    async function completeMock() {
      if (!sessionId || params.get("mock") !== "1") return;
      try {
        await fetch(`${API_URL}/payments/mock-complete`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ sessionId }),
        });
      } catch (_) {}
    }

    (async () => {
      await completeMock();
      await clearCart();
      fetch(`${API_URL}/analytics/events`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: "purchase", payload: { sessionId }, locale }),
      }).catch(() => {});
    })();
  </script>
</BaseLayout>
