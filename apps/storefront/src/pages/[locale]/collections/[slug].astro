---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t, localizePath, type Locale } from "../../../i18n/ui";
import { apiGet } from "../../../lib/api";

export function getStaticPaths() {
  return [
    { params: { locale: "en", slug: "home" } },
    { params: { locale: "de", slug: "zuhause" } },
    { params: { locale: "de", slug: "home" } },
  ];
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug!;

type ProductList = {
  items: {
    translations: { locale: string; title: string; slug: string }[];
    media: { url: string; alt: string }[];
    variants: { price: number }[];
  }[];
};

let products: ProductList["items"] = [];
try {
  const data = await apiGet<ProductList>(
    `/products?locale=${locale}&collection=${slug}&take=24`,
  );
  products = data.items;
} catch {
  try {
    const data = await apiGet<ProductList>(`/products?locale=${locale}&take=24`);
    products = data.items;
  } catch {
    products = [];
  }
}
---

<BaseLayout locale={locale} title={slug} canonicalPath={`/collections/${slug}`}>
  <section class="section">
    <div class="container">
      <h1 class="section__title">{t(locale, "nav.shop")}</h1>
      <div class="product-grid">
        {
          products.map((p) => {
            const tr =
              p.translations.find((x) => x.locale === locale) ?? p.translations[0];
            const price = p.variants[0]?.price ?? 0;
            const img = p.media[0];
            return (
              <a class="product-card" href={localizePath(locale, `/products/${tr?.slug}`)}>
                <div class="product-card__media">
                  {img ? <img src={img.url} alt={img.alt || tr?.title || ""} loading="lazy" /> : null}
                </div>
                <h2 class="product-card__title">{tr?.title}</h2>
                <p class="product-card__price">€{(price / 100).toFixed(2)}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
