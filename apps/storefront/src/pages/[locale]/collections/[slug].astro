---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ProductFilters from "../../../components/ProductFilters";
import { type Locale, locales, localizePath, t } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { API_URL, apiGet } from "../../../lib/api";

export async function getStaticPaths() {
  const seen = new Set<string>();
  const paths: { params: { locale: string; slug: string } }[] = [];
  const push = (locale: string, slug: string) => {
    const key = `${locale}:${slug}`;
    if (seen.has(key)) return;
    seen.add(key);
    paths.push({ params: { locale, slug } });
  };
  for (const locale of locales) {
    try {
      const collections = await apiGet<
        {
          translations: { locale: string; slug: string }[];
          children?: { translations: { locale: string; slug: string }[] }[];
        }[]
      >(`/collections?locale=${locale}`);
      for (const c of collections) {
        const tr =
          c.translations.find((x) => x.locale === locale) ?? c.translations[0];
        if (tr?.slug) push(locale, tr.slug);
        for (const child of c.children ?? []) {
          const ctr =
            child.translations.find((x) => x.locale === locale) ??
            child.translations[0];
          if (ctr?.slug) push(locale, ctr.slug);
        }
      }
    } catch {
      // API offline during build
    }
  }
  if (!paths.length) {
    for (const locale of locales) {
      for (const slug of [
        "dogs",
        "cats",
        "small-pets",
        "hunde",
        "katzen",
        "kleintiere",
      ]) {
        push(locale, slug);
      }
    }
  }
  return paths;
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug!;

type Collection = {
  id: string;
  translations: {
    locale: string;
    title: string;
    slug: string;
    description: string;
  }[];
  children?: {
    id: string;
    translations: {
      locale: string;
      title: string;
      slug: string;
      description: string;
    }[];
  }[];
  products?: {
    product: {
      id: string;
      translations: { locale: string; title: string; slug: string }[];
      media: { url: string; alt: string }[];
      variants: {
        id: string;
        price: number;
        compareAtPrice?: number | null;
        option1?: string | null;
      }[];
      metafields?: { namespace: string; key: string; value: unknown }[];
    };
  }[];
};

let collection: Collection | null = null;
try {
  collection = await apiGet<Collection>(`/collections/${locale}/${slug}`);
} catch {
  collection = null;
}

const tr =
  collection?.translations.find((x) => x.locale === locale) ??
  collection?.translations[0];

const children = collection?.children ?? [];
const isHub = children.length > 0;

let products =
  collection?.products?.map((cp) => cp.product).filter(Boolean) ?? [];

if (!products.length) {
  try {
    const data = await apiGet<{
      items: typeof products;
    }>(`/products?locale=${locale}&collection=${slug}&take=48`);
    products = data.items;
  } catch {
    products = [];
  }
}
---

<BaseLayout
  locale={locale}
  title={tr?.title ?? slug}
  description={tr?.description || t(locale, "home.lead")}
  canonicalPath={`/collections/${slug}`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t(locale, "nav.home"),
        item: `/${locale}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t(locale, "shop.title"),
        item: `/${locale}/shop`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: tr?.title ?? slug,
        item: `/${locale}/collections/${slug}`,
      },
    ],
  }}
>
  <div class="container page-shell">
    <Breadcrumbs
      items={[
        { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
        { label: t(locale, "shop.title"), href: localizePath(locale, "/shop") },
        { label: tr?.title ?? slug },
      ]}
      label={t(locale, "product.breadcrumb")}
    />
    <h1 class="section__title">{tr?.title ?? slug}</h1>
    {tr?.description ? <p class="section__lead">{tr.description}</p> : null}

      {
        isHub ? (
          <>
            <h2 class="section__title" style="font-size:1.35rem">
              {t(locale, "collection.children")}
            </h2>
            <div class="collection-children">
              {children.map((child) => {
                const ctr =
                  child.translations.find((x) => x.locale === locale) ??
                  child.translations[0];
                return (
                  <a
                    class="collection-child"
                    href={localizePath(locale, `/collections/${ctr?.slug}`)}
                  >
                    <p class="collection-child__title">{ctr?.title}</p>
                    <p class="collection-child__desc">{ctr?.description}</p>
                  </a>
                );
              })}
            </div>
            <h2 class="section__title" style="font-size:1.35rem">
              {t(locale, "collection.shop")}
            </h2>
          </>
        ) : null
      }

    <ProductFilters
      client:load
      locale={locale}
      apiUrl={API_URL}
      products={products}
      labels={{
        sort: t(locale, "shop.sort"),
        filterLife: t(locale, "shop.filterLife"),
        filterType: t(locale, "shop.filterType"),
        all: t(locale, "shop.all"),
        from: t(locale, "product.from"),
        sale: t(locale, "product.sale"),
        add: t(locale, "product.add"),
        wishlist: t(locale, "product.wishlist"),
        wishlistAdded: t(locale, "product.wishlistAdded"),
        addError: t(locale, "product.addError"),
      }}
    />
  </div>
</BaseLayout>
