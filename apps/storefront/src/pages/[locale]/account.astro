---
import AccountClient from "../../components/AccountClient";
import { type Locale, locales, t } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { API_URL } from "../../lib/api";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<BaseLayout locale={locale} title={t(locale, "account.login")} canonicalPath="/account">
  <div class="container section" style="max-width:36rem">
    <h1 class="section__title">{t(locale, "account.login")}</h1>
    <AccountClient
      client:load
      apiUrl={API_URL}
      labels={{
        orders: t(locale, "account.orders"),
        logout: t(locale, "account.logout"),
        noOrders: t(locale, "account.noOrders"),
      }}
    />
  </div>
</BaseLayout>
