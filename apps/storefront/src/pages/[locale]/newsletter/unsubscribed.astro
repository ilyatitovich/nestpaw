---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import {
  type Locale,
  locales,
  localizePath,
  storeName,
  t,
} from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  { label: t(locale, "newsletter.unsubscribedTitle") },
];
---

<BaseLayout
  title={`${t(locale, "newsletter.unsubscribedTitle")} — ${storeName}`}
  description={t(locale, "newsletter.unsubscribedLead")}
  locale={locale}
  canonicalPath="/newsletter/unsubscribed"
>
  <section class="container page-shell newsletter-result">
    <Breadcrumbs
      items={breadcrumbs}
      label={t(locale, "product.breadcrumb")}
    />
    <h1>{t(locale, "newsletter.unsubscribedTitle")}</h1>
    <p class="section__lead">{t(locale, "newsletter.unsubscribedLead")}</p>
    <p>
      <a class="btn" href={localizePath(locale, "/")}>{t(locale, "404.cta")}</a>
    </p>
  </section>
</BaseLayout>
