---
import {
  type Locale,
  locales,
  localizePath,
  storeName,
  t,
} from "../../i18n/ui";
import HeroCarousel from "../../components/HeroCarousel.astro";
import ProductCard from "../../components/ProductCard";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { API_URL, apiGet } from "../../lib/api";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

type ProductList = {
  items: {
    id: string;
    translations: { locale: string; title: string; slug: string }[];
    media: { url: string; alt: string }[];
    variants: {
      id: string;
      price: number;
      compareAtPrice?: number | null;
      option1?: string | null;
    }[];
  }[];
};

let products: ProductList["items"] = [];
try {
  const data = await apiGet<ProductList>(`/products?locale=${locale}&take=8`);
  products = data.items;
} catch {
  products = [];
}

const dogsSlug = locale === "de" ? "hunde" : "dogs";
const catsSlug = locale === "de" ? "katzen" : "cats";
const smallSlug = locale === "de" ? "kleintiere" : "small-pets";

const petTiles = [
  {
    slug: dogsSlug,
    label: t(locale, "nav.dogs"),
    image:
      "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=900&q=80",
  },
  {
    slug: catsSlug,
    label: t(locale, "nav.cats"),
    image:
      "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=900&q=80",
  },
  {
    slug: smallSlug,
    label: t(locale, "nav.smallPets"),
    image:
      "https://images.unsplash.com/photo-1425082661705-1834bfd09dca?w=900&q=80",
  },
];
---

<BaseLayout
  locale={locale}
  title={`${storeName} — ${t(locale, "home.headline")}`}
  description={t(locale, "home.lead")}
  canonicalPath="/"
  ogImage="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=1200&q=80"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "PetStore",
    name: storeName,
    url: Astro.site?.toString(),
    description: t(locale, "home.lead"),
  }}
>
  <h1 class="visually-hidden">{storeName}</h1>
  <HeroCarousel locale={locale} />

  <section class="section">
    <div class="container">
      <h2 class="section__title">{t(locale, "home.shopByPet")}</h2>
      <div class="pet-grid">
        {
          petTiles.map((tile) => (
            <a class="pet-tile" href={localizePath(locale, `/collections/${tile.slug}`)}>
              <div class="pet-tile__media">
                <img src={tile.image} alt={tile.label} loading="lazy" />
              </div>
              <span class="pet-tile__label">{tile.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">{t(locale, "home.featured")}</h2>
      <p class="section__lead">{t(locale, "home.lead")}</p>
      <div class="product-grid">
        {
          products.map((p) => {
            const tr =
              p.translations.find((x) => x.locale === locale) ?? p.translations[0];
            return (
              <ProductCard
                client:visible
                product={p}
                locale={locale}
                apiUrl={API_URL}
                href={localizePath(locale, `/products/${tr?.slug}`)}
                heading="h3"
                labels={{
                  from: t(locale, "product.from"),
                  sale: t(locale, "product.sale"),
                  add: t(locale, "product.add"),
                  wishlist: t(locale, "product.wishlist"),
                  wishlistAdded: t(locale, "product.wishlistAdded"),
                  addError: t(locale, "product.addError"),
                }}
              />
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
