---
import type { TipTapDoc } from "@online-store/rich-text";
import AddToCart from "../../../components/AddToCart";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ProductCard from "../../../components/ProductCard";
import ProductDetails from "../../../components/ProductDetails.astro";
import ProductGallery from "../../../components/ProductGallery.astro";
import { type Locale, locales, localizePath, t } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { API_URL, apiGet } from "../../../lib/api";

export async function getStaticPaths() {
  const paths: { params: { locale: string; slug: string } }[] = [];
  for (const locale of locales) {
    try {
      const data = await apiGet<{
        items: { translations: { locale: string; slug: string }[] }[];
      }>(`/products?locale=${locale}&take=100`);
      for (const p of data.items) {
        const tr = p.translations.find((x) => x.locale === locale);
        if (tr) paths.push({ params: { locale, slug: tr.slug } });
      }
    } catch {
      // API may be offline during build
    }
  }
  if (!paths.length) {
    return [
      { params: { locale: "en", slug: "meadow-adult-dry-food" } },
      { params: { locale: "de", slug: "wiesen-adult-trockenfutter" } },
    ];
  }
  return paths;
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug!;

type CollectionNode = {
  id: string;
  parentId: string | null;
  translations: { locale: string; title: string; slug: string }[];
};

type Product = {
  id: string;
  option1Name?: string | null;
  translations: {
    locale: string;
    title: string;
    description: string;
    body?: TipTapDoc | null;
    slug: string;
    seoTitle?: string;
    seoDescription?: string;
  }[];
  media: { url: string; alt: string }[];
  variants: {
    id: string;
    price: number;
    compareAtPrice?: number | null;
    lowestPrice30d?: number | null;
    unitAmountGrams?: number | null;
    option1?: string | null;
    inventory?: { quantity: number } | null;
  }[];
  metafields?: { namespace: string; key: string; value: unknown }[];
  collections?: { collection: CollectionNode }[];
  reviews?: {
    rating: number;
    title?: string;
    body: string;
    authorName: string;
  }[];
};

let product: Product | null = null;
try {
  product = await apiGet<Product>(`/products/${locale}/${slug}`);
} catch {
  product = null;
}

const tr =
  product?.translations.find((x) => x.locale === locale) ??
  product?.translations[0];
const img = product?.media[0];
const variant = product?.variants[0];

function petMeta(key: string) {
  const m = product?.metafields?.find(
    (x) => x.namespace === "pet" && x.key === key,
  );
  return typeof m?.value === "string" ? m.value : null;
}

function brandMeta() {
  const m = product?.metafields?.find(
    (x) =>
      (x.namespace === "product" || x.namespace === "pet") && x.key === "brand",
  );
  return typeof m?.value === "string" ? m.value : null;
}

const brand = brandMeta();

const saleVariant =
  product?.variants.find(
    (v) => v.compareAtPrice != null && v.compareAtPrice > v.price,
  ) ?? null;
const salePercent = saleVariant?.compareAtPrice
  ? Math.round(
      ((saleVariant.compareAtPrice - saleVariant.price) /
        saleVariant.compareAtPrice) *
        100,
    )
  : null;

const money = (cents: number) =>
  new Intl.NumberFormat(locale === "de" ? "de-DE" : "en-IE", {
    style: "currency",
    currency: "EUR",
  }).format(cents / 100);

const unitPriceLabel =
  variant?.unitAmountGrams && variant.unitAmountGrams > 0
    ? t(locale, "product.unitPrice").replace(
        "{price}",
        money((variant.price * 1000) / variant.unitAmountGrams),
      )
    : null;

const omnibusLabel =
  variant?.lowestPrice30d != null &&
  variant.compareAtPrice != null &&
  variant.compareAtPrice > variant.price
    ? t(locale, "product.lowestPrice").replace(
        "{price}",
        money(variant.lowestPrice30d),
      )
    : null;

const collectionTrail = (product?.collections ?? [])
  .map((c) => c.collection)
  .sort((a, b) => {
    if (!a.parentId && b.parentId) return -1;
    if (a.parentId && !b.parentId) return 1;
    return 0;
  })
  .map((c) => {
    const ctr =
      c.translations.find((x) => x.locale === locale) ?? c.translations[0];
    return ctr
      ? {
          label: ctr.title,
          href: localizePath(locale, `/collections/${ctr.slug}`),
        }
      : null;
  })
  .filter((x): x is { label: string; href: string } => Boolean(x));

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  ...collectionTrail,
  ...(tr ? [{ label: tr.title }] : []),
];

const variantSizes = (product?.variants ?? [])
  .map((v) => v.option1)
  .filter((x): x is string => Boolean(x));

const specs: { label: string; value: string }[] = [
  petMeta("species")
    ? { label: String(t(locale, "product.species")), value: petMeta("species")! }
    : null,
  petMeta("life_stage")
    ? {
        label: String(t(locale, "product.lifeStage")),
        value: petMeta("life_stage")!,
      }
    : null,
  petMeta("product_type")
    ? {
        label: String(t(locale, "product.type")),
        value: petMeta("product_type")!,
      }
    : null,
  petMeta("size_class") && petMeta("size_class") !== "na"
    ? { label: String(t(locale, "product.size")), value: petMeta("size_class")! }
    : null,
  variantSizes.length
    ? {
        label: String(t(locale, "product.variantSizes")),
        value: variantSizes.join(", "),
      }
    : null,
].filter((x): x is { label: string; value: string } => x != null);

const shareUrl = new URL(
  `/${locale}/products/${slug}`,
  Astro.site ?? "http://localhost:4321",
).href;

let related: {
  id: string;
  translations: { locale: string; title: string; slug: string }[];
  media: { url: string; alt: string }[];
  variants: {
    id: string;
    price: number;
    compareAtPrice?: number | null;
    option1?: string | null;
  }[];
}[] = [];

if (product) {
  try {
    const data = await apiGet<{ items: typeof related }>(
      `/products/${product.id}/related?locale=${locale}&take=4`,
    );
    related = data.items;
  } catch {
    related = [];
  }
}
---

{
  product && tr && variant ? (
    <BaseLayout
      locale={locale}
      title={tr.seoTitle ?? tr.title}
      description={tr.seoDescription ?? tr.description.slice(0, 160)}
      canonicalPath={`/products/${slug}`}
      ogImage={img?.url}
      jsonLd={[
        {
          "@context": "https://schema.org",
          "@type": "Product",
          name: tr.title,
          description: tr.description,
          image:
            product.media.length > 1
              ? product.media.map((m) => m.url)
              : img?.url,
          brand: brand ? { "@type": "Brand", name: brand } : undefined,
          offers: {
            "@type": "Offer",
            priceCurrency: "EUR",
            price: (variant.price / 100).toFixed(2),
            availability: "https://schema.org/InStock",
          },
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbs.map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.label,
            item:
              "href" in item && item.href
                ? new URL(item.href, Astro.site ?? "http://localhost:4321").href
                : new URL(
                    `/${locale}/products/${slug}`,
                    Astro.site ?? "http://localhost:4321",
                  ).href,
          })),
        },
      ]}
    >
      <div class="container pdp-page">
        <Breadcrumbs items={breadcrumbs} label={t(locale, "product.breadcrumb")} />

        <div class="pdp">
          <ProductGallery
            media={product.media}
            title={tr.title}
            productId={product.id}
            salePercent={salePercent}
            saleLabel={t(locale, "product.sale")}
            wishlistAddLabel={t(locale, "product.wishlist")}
            wishlistRemoveLabel={t(locale, "product.wishlistAdded")}
            prevLabel={t(locale, "product.galleryPrev")}
            nextLabel={t(locale, "product.galleryNext")}
            gotoLabel={t(locale, "product.galleryGoto")}
            galleryLabel={t(locale, "product.galleryLabel")}
            closeLabel={t(locale, "product.galleryClose")}
          />

          <div class="pdp__info">
            {brand ? <p class="pdp__brand">{brand}</p> : null}
            <h1 class="pdp__title">{tr.title}</h1>

            <AddToCart
              client:load
              apiUrl={API_URL}
              variants={product.variants}
              option1Name={product.option1Name}
              description={tr.description}
              label={t(locale, "product.add")}
              locale={locale}
              qtyLabel={t(locale, "product.qty")}
              decreaseLabel={t(locale, "product.decreaseQty")}
              increaseLabel={t(locale, "product.increaseQty")}
              inStockLabel={t(locale, "product.inStock")}
              outOfStockLabel={t(locale, "product.outOfStock")}
              errorLabel={t(locale, "product.addError")}
            />
            {unitPriceLabel ? <p class="pdp__unit-price">{unitPriceLabel}</p> : null}
            {omnibusLabel ? <p class="pdp__omnibus">{omnibusLabel}</p> : null}
          </div>
        </div>

        <ProductDetails
          locale={locale}
          apiUrl={API_URL}
          productId={product.id}
          title={tr.title}
          description={tr.description}
          body={tr.body}
          shareUrl={shareUrl}
          specs={specs}
          reviews={product.reviews}
        />
      </div>

      {related.length ? (
        <section class="section">
          <div class="container">
            <h2 class="section__title">{t(locale, "product.related")}</h2>
            <div class="product-grid">
              {related.map((p) => {
                const rtr =
                  p.translations.find((x) => x.locale === locale) ??
                  p.translations[0];
                return (
                  <ProductCard
                    client:visible
                    product={p}
                    locale={locale}
                    apiUrl={API_URL}
                    href={localizePath(locale, `/products/${rtr?.slug}`)}
                    heading="h3"
                    labels={{
                      from: t(locale, "product.from"),
                      sale: t(locale, "product.sale"),
                      add: t(locale, "product.add"),
                      wishlist: t(locale, "product.wishlist"),
                      wishlistAdded: t(locale, "product.wishlistAdded"),
                      addError: t(locale, "product.addError"),
                    }}
                  />
                );
              })}
            </div>
          </div>
        </section>
      ) : null}

      <script>
        const KEY = "nestpaw-wishlist";

        function readIds(): string[] {
          try {
            const raw = localStorage.getItem(KEY);
            const parsed = raw ? JSON.parse(raw) : [];
            return Array.isArray(parsed) ? parsed.filter((x) => typeof x === "string") : [];
          } catch {
            return [];
          }
        }

        function writeIds(ids: string[]) {
          localStorage.setItem(KEY, JSON.stringify(ids));
        }

        function syncButton(btn: HTMLButtonElement) {
          const id = btn.dataset.productId;
          if (!id) return;
          const saved = readIds().includes(id);
          btn.setAttribute("aria-pressed", saved ? "true" : "false");
          btn.setAttribute(
            "aria-label",
            saved
              ? btn.dataset.labelRemove || "Remove from wishlist"
              : btn.dataset.labelAdd || "Add to wishlist",
          );
        }

        document.querySelectorAll<HTMLButtonElement>("[data-wishlist-toggle]").forEach((btn) => {
          syncButton(btn);
          btn.addEventListener("click", () => {
            const id = btn.dataset.productId;
            if (!id) return;
            const ids = readIds();
            const next = ids.includes(id)
              ? ids.filter((x) => x !== id)
              : [...ids, id];
            writeIds(next);
            syncButton(btn);
          });
        });
      </script>
    </BaseLayout>
  ) : (
    <BaseLayout locale={locale} title="Not found" canonicalPath={`/products/${slug}`}>
      <div class="container page-shell empty-state">
        <Breadcrumbs
          items={[
            { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
            { label: t(locale, "404.title") },
          ]}
          label={t(locale, "product.breadcrumb")}
        />
        <h1 class="section__title">{t(locale, "404.title")}</h1>
        <p class="section__lead">{t(locale, "404.lead")}</p>
        <a class="btn btn--primary" href={localizePath(locale, "/shop")}>
          {t(locale, "404.cta")}
        </a>
      </div>
    </BaseLayout>
  )
}
