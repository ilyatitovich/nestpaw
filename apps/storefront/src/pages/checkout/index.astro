---
import CheckoutClient from "@/components/CheckoutClient";
import { defaultLocale, type Locale, localizePath, t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { API_URL } from "@/lib/api";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
---

<BaseLayout
  locale={locale}
  title={t(locale, "checkout.title")}
  canonicalPath="/checkout"
  chrome="checkout"
>
  <div class="container page-shell">
    <h1 class="section__title">{t(locale, "checkout.title")}</h1>
    <CheckoutClient
      client:load
      apiUrl={API_URL}
      locale={locale}
      storeUrl={import.meta.env.PUBLIC_STORE_URL ?? "http://localhost:4321"}
      cartHref={localizePath(locale, "/cart")}
      stripePublishableKey={import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ?? ""}
      labels={{
        contact: t(locale, "checkout.contact"),
        delivery: t(locale, "checkout.delivery"),
        shipping: t(locale, "checkout.shipping"),
        shippingMethod: t(locale, "checkout.shippingMethod"),
        payment: t(locale, "checkout.payment"),
        orderSummary: t(locale, "checkout.orderSummary"),
        paySecurely: t(locale, "checkout.paySecurely"),
        secureNote: t(locale, "checkout.secureNote"),
        taxesNote: t(locale, "checkout.taxesNote"),
        emptyRedirect: t(locale, "checkout.emptyRedirect"),
        editCart: t(locale, "checkout.editCart"),
        firstName: t(locale, "checkout.firstName"),
        lastName: t(locale, "checkout.lastName"),
        email: t(locale, "checkout.email"),
        line1: t(locale, "checkout.line1"),
        line2: t(locale, "checkout.line2"),
        city: t(locale, "checkout.city"),
        postalCode: t(locale, "checkout.postalCode"),
        country: t(locale, "checkout.country"),
        phone: t(locale, "checkout.phone"),
        countryDE: t(locale, "checkout.countryDE"),
        countryAT: t(locale, "checkout.countryAT"),
        countryFR: t(locale, "checkout.countryFR"),
        countryNL: t(locale, "checkout.countryNL"),
        countryBE: t(locale, "checkout.countryBE"),
        subtotal: t(locale, "cart.subtotal"),
        discountLabel: t(locale, "cart.discountLabel"),
        total: t(locale, "cart.total"),
        shippingCost: t(locale, "checkout.shippingCost"),
        vatIncluded: t(locale, "checkout.vatIncluded"),
        acceptTerms: t(locale, "checkout.acceptTerms"),
        payObligation: t(locale, "checkout.payObligation"),
        termsRequired: t(locale, "checkout.termsRequired"),
        expressTitle: t(locale, "checkout.expressTitle"),
        expressOr: t(locale, "checkout.expressOr"),
        continue: t(locale, "checkout.continueStep"),
        returnTo: t(locale, "checkout.returnTo"),
        edit: t(locale, "checkout.edit"),
        freeShipping: t(locale, "checkout.freeShipping"),
        savedAddresses: t(locale, "checkout.savedAddresses"),
        newAddress: t(locale, "checkout.newAddress"),
        billingDifferent: t(locale, "checkout.billingDifferent"),
        billingAddress: t(locale, "checkout.billingAddress"),
        paymentUnavailable: t(locale, "checkout.paymentUnavailable"),
        shippingRequired: t(locale, "checkout.shippingRequired"),
        showSummary: t(locale, "checkout.showSummary"),
        hideSummary: t(locale, "checkout.hideSummary"),
        errorRequired: t(locale, "checkout.errorRequired"),
        errorEmailInvalid: t(locale, "checkout.errorEmailInvalid"),
        errorNameInvalid: t(locale, "checkout.errorNameInvalid"),
        errorPostalInvalid: t(locale, "checkout.errorPostalInvalid"),
        errorCountryInvalid: t(locale, "checkout.errorCountryInvalid"),
        errorPhoneInvalid: t(locale, "checkout.errorPhoneInvalid"),
        errorGeneric: t(locale, "checkout.errorGeneric"),
        errorLoad: t(locale, "checkout.errorLoad"),
      }}
    />
  </div>
</BaseLayout>
