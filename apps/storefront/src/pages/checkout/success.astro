---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { defaultLocale, type Locale, localizePath, t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { API_URL } from "@/lib/api";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  { label: t(locale, "checkout.successTitle") },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, "checkout.successTitle")}
  canonicalPath="/checkout/success"
>
  <div class="container page-shell">
    <Breadcrumbs
      items={breadcrumbs}
      label={t(locale, "product.breadcrumb")}
    />
    <h1 class="section__title">{t(locale, "checkout.successTitle")}</h1>
    <p>{t(locale, "checkout.successLead")}</p>
    <a class="btn btn--primary" href={localizePath(locale, "/")}>
      {t(locale, "checkout.continue")}
    </a>
  </div>
  <script is:inline define:vars={{ API_URL, locale }}>
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session_id");
    const cartToken = localStorage.getItem("cart_token");

    async function clearCart() {
      if (!cartToken) return;
      try {
        await fetch(`${API_URL}/cart`, {
          method: "DELETE",
          headers: { "X-Cart-Token": cartToken },
        });
      } catch (_) {}
    }

    async function completeMock() {
      if (!sessionId || params.get("mock") !== "1") return;
      try {
        await fetch(`${API_URL}/payments/mock-complete`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ sessionId }),
        });
      } catch (_) {}
    }

    (async () => {
      await completeMock();
      await clearCart();
      fetch(`${API_URL}/analytics/events`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: "purchase", payload: { sessionId }, locale }),
      }).catch(() => {});
    })();
  </script>
</BaseLayout>
