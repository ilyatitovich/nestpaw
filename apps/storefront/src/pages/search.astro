---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SearchClient from "../components/SearchClient";
import { defaultLocale, type Locale, localizePath, t } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { API_URL } from "../lib/api";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const initialQuery = Astro.url.searchParams.get("q") ?? "";

const breadcrumbs = [
  { label: t(locale, "nav.home"), href: localizePath(locale, "/") },
  { label: t(locale, "search.title") },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, "search.title")}
  description={t(locale, "search.placeholder")}
  canonicalPath="/search"
>
  <div class="container page-shell search-page">
    <Breadcrumbs
      items={breadcrumbs}
      label={t(locale, "product.breadcrumb")}
    />
    <h1 class="section__title">{t(locale, "search.title")}</h1>
    <SearchClient
      client:load
      apiUrl={API_URL}
      locale={locale}
      initialQuery={initialQuery}
      labels={{
        empty: t(locale, "search.empty"),
        from: t(locale, "product.from"),
        clearAll: t(locale, "search.clearAll"),
        queryChip: t(locale, "search.queryChip"),
        onSale: t(locale, "search.onSale"),
        price: t(locale, "search.price"),
        priceMin: t(locale, "search.priceMin"),
        priceMax: t(locale, "search.priceMax"),
        filters: t(locale, "search.filters"),
        sort: t(locale, "shop.sort"),
        sortRelevance: t(locale, "search.sortRelevance"),
        sortPriceAsc: t(locale, "search.sortPriceAsc"),
        sortPriceDesc: t(locale, "search.sortPriceDesc"),
        sortName: t(locale, "search.sortName"),
        viewGrid: t(locale, "search.viewGrid"),
        viewList: t(locale, "search.viewList"),
        viewGroup: t(locale, "search.viewGroup"),
        noQuery: t(locale, "search.noQuery"),
        removeFilter: t(locale, "search.removeFilter"),
        species: t(locale, "product.species"),
        lifeStage: t(locale, "product.lifeStage"),
        type: t(locale, "product.type"),
        size: t(locale, "product.size"),
        sale: t(locale, "product.sale"),
        loading: t(locale, "search.loading"),
        add: t(locale, "product.add"),
        wishlist: t(locale, "product.wishlist"),
        wishlistAdded: t(locale, "product.wishlistAdded"),
        addError: t(locale, "product.addError"),
      }}
    />
  </div>
</BaseLayout>
