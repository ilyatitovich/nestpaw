---
import "../styles/global.css";
import { type Locale, localizePath, storeName, t } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  locale: Locale | string;
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Everyday essentials for dogs, cats, and small pets",
  locale,
  canonicalPath = "/",
  ogImage,
  jsonLd,
} = Astro.props;

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "http://localhost:4321";
const canonical = `${site}${localizePath(locale, canonicalPath)}`;
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER ?? "plausible";
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const ga4 = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const dogsSlug = locale === "de" ? "hunde" : "dogs";
const catsSlug = locale === "de" ? "katzen" : "cats";
const smallSlug = locale === "de" ? "kleintiere" : "small-pets";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${site}/en${canonicalPath === "/" ? "" : canonicalPath}`} />
    <link rel="alternate" hreflang="de" href={`${site}/de${canonicalPath === "/" ? "" : canonicalPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/en${canonicalPath === "/" ? "" : canonicalPath}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Outfit:wght@500;650;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd ? (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ) : null}
    {
      provider === "plausible" && plausibleDomain ? (
        <script
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      ) : null
    }
    {
      provider === "ga4" && ga4 ? (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script
            is:inline
            define:vars={{ ga4 }}
          >{`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', ga4);`}</script>
        </>
      ) : null
    }
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="container site-header__inner">
          <a class="site-header__brand" href={localizePath(locale, "/")}>{storeName}</a>
          <nav class="site-nav" aria-label="Primary">
            <a class="site-nav__link" href={localizePath(locale, `/collections/${dogsSlug}`)}>
              {t(locale, "nav.dogs")}
            </a>
            <a class="site-nav__link" href={localizePath(locale, `/collections/${catsSlug}`)}>
              {t(locale, "nav.cats")}
            </a>
            <a class="site-nav__link" href={localizePath(locale, `/collections/${smallSlug}`)}>
              {t(locale, "nav.smallPets")}
            </a>
            <a class="site-nav__link" href={localizePath(locale, "/shop")}>
              {t(locale, "nav.shop")}
            </a>
            <a class="site-nav__link" href={localizePath(locale, "/search")}>
              {t(locale, "nav.search")}
            </a>
            <a class="site-nav__link" href={localizePath(locale, "/cart")}>
              {t(locale, "nav.cart")}
            </a>
            <a class="site-nav__link" href={localizePath(locale, "/account")}>
              {t(locale, "nav.account")}
            </a>
            <div class="locale-switch">
              <a class={`locale-switch__btn ${locale === "en" ? "is-active" : ""}`} href="/en/">EN</a>
              <a class={`locale-switch__btn ${locale === "de" ? "is-active" : ""}`} href="/de/">DE</a>
            </div>
          </nav>
        </div>
      </header>
      <main class="page__main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container site-footer__inner">
          <span class="site-footer__brand">{storeName}</span>
          <div class="site-footer__links">
            <a href={localizePath(locale, "/pages/about")}>{t(locale, "footer.about")}</a>
            <a href={localizePath(locale, "/pages/shipping")}>{t(locale, "footer.shipping")}</a>
            <a href={localizePath(locale, "/pages/returns")}>{t(locale, "footer.returns")}</a>
            <a href={localizePath(locale, "/pages/privacy")}>{t(locale, "footer.privacy")}</a>
            <a href={localizePath(locale, "/pages/terms")}>{t(locale, "footer.terms")}</a>
            <a href={localizePath(locale, "/pages/contact")}>{t(locale, "footer.contact")}</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
