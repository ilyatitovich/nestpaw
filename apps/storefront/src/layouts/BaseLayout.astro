---
import AuthChrome from "../components/AuthChrome.astro";
import CookieConsent from "../components/CookieConsent.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import PromoBanner from "../components/PromoBanner.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { type Locale, localizePath } from "../i18n/ui";
import {
  COOKIE_CONSENT_ACCEPTED,
  COOKIE_CONSENT_KEY,
} from "../lib/cookie-consent";

interface Props {
  title: string;
  description?: string;
  locale: Locale | string;
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** full = store chrome; account = guest auth shell, full chrome after sign-in */
  chrome?: "full" | "account";
}

const {
  title,
  description = "Everyday essentials for dogs, cats, and small pets",
  locale,
  canonicalPath = "/",
  ogImage,
  jsonLd,
  chrome = "full",
} = Astro.props;
const isAccountChrome = chrome === "account";

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "http://localhost:4321";
const canonical = `${site}${localizePath(locale, canonicalPath)}`;
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER ?? "plausible";
// Keep a disabled Plausible tag in HTML even when env is unset (local/demo).
const plausibleDomain =
  import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ||
  (provider === "plausible" ? "localhost" : undefined);
const ga4 = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const hasAnalytics =
  (provider === "plausible" && Boolean(plausibleDomain)) ||
  (provider === "ga4" && Boolean(ga4));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${site}/en${canonicalPath === "/" ? "" : canonicalPath}`} />
    <link rel="alternate" hreflang="de" href={`${site}/de${canonicalPath === "/" ? "" : canonicalPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/en${canonicalPath === "/" ? "" : canonicalPath}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Outfit:wght@500;650;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd ? (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ) : null}
    {
      provider === "plausible" && plausibleDomain ? (
        <script
          is:inline
          type="text/plain"
          data-consent="analytics"
          data-consent-state="disabled"
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      ) : null
    }
    {
      provider === "ga4" && ga4 ? (
        <>
          <script
            is:inline
            type="text/plain"
            data-consent="analytics"
            data-consent-state="disabled"
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}
          />
          <script
            is:inline
            type="text/plain"
            data-consent="analytics"
            data-consent-state="disabled"
          >
            {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', ${JSON.stringify(ga4)});`}
          </script>
        </>
      ) : null
    }
    {
      hasAnalytics ? (
        <script
          is:inline
          define:vars={{
            COOKIE_CONSENT_KEY,
            COOKIE_CONSENT_ACCEPTED,
          }}
        >
          window.__activateAnalyticsConsent = function activateAnalyticsConsent() {
            document
              .querySelectorAll(
                'script[data-consent="analytics"][data-consent-state="disabled"]',
              )
              .forEach(function (old) {
                var next = document.createElement("script");
                for (var i = 0; i < old.attributes.length; i++) {
                  var attr = old.attributes[i];
                  if (attr.name === "type" || attr.name === "data-consent-state")
                    continue;
                  next.setAttribute(attr.name, attr.value);
                }
                next.type = "text/javascript";
                next.setAttribute("data-consent-state", "accepted");
                if (!old.src) next.textContent = old.textContent;
                old.replaceWith(next);
              });
          };

          try {
            if (
              localStorage.getItem(COOKIE_CONSENT_KEY) === COOKIE_CONSENT_ACCEPTED
            ) {
              window.__activateAnalyticsConsent();
            }
          } catch (e) {}
        </script>
      ) : null
    }
    {
      isAccountChrome ? (
        <script is:inline>
          // Paint the last-known chrome before body to avoid guest→member flash.
          try {
            document.documentElement.dataset.accountSession =
              sessionStorage.getItem("nestpaw-account-session") === "member"
                ? "member"
                : "guest";
          } catch (e) {
            document.documentElement.dataset.accountSession = "guest";
          }
        </script>
      ) : null
    }
  </head>
  <body class:list={[isAccountChrome && "page--account"]}>
    <div class="page">
      {
        isAccountChrome ? (
          <>
            <div data-account-chrome="guest">
              <AuthChrome locale={locale} part="header" />
            </div>
            <div
              class="site-chrome"
              data-site-chrome
              data-account-chrome="member"
              hidden
              inert
            >
              <PromoBanner locale={locale} />
              <SiteHeader locale={locale} />
            </div>
            <script is:inline>
              (function () {
                var mode =
                  document.documentElement.dataset.accountSession || "guest";
                document
                  .querySelectorAll("[data-account-chrome]")
                  .forEach(function (el) {
                    var show =
                      el.getAttribute("data-account-chrome") === mode;
                    el.hidden = !show;
                    if (show) el.removeAttribute("inert");
                    else el.setAttribute("inert", "");
                  });
              })();
            </script>
          </>
        ) : (
          <div class="site-chrome" data-site-chrome>
            <PromoBanner locale={locale} />
            <SiteHeader locale={locale} />
          </div>
        )
      }
      <main class="page__main">
        <slot />
      </main>
      {
        isAccountChrome ? (
          <>
            <div data-account-chrome="guest">
              <AuthChrome locale={locale} part="footer" />
            </div>
            <div data-account-chrome="member" hidden inert>
              <NewsletterSignup locale={locale} />
              <SiteFooter locale={locale} />
            </div>
            <script is:inline>
              (function () {
                var mode =
                  document.documentElement.dataset.accountSession || "guest";
                document
                  .querySelectorAll("[data-account-chrome]")
                  .forEach(function (el) {
                    var show =
                      el.getAttribute("data-account-chrome") === mode;
                    el.hidden = !show;
                    if (show) el.removeAttribute("inert");
                    else el.setAttribute("inert", "");
                  });
              })();
            </script>
          </>
        ) : (
          <>
            <NewsletterSignup locale={locale} />
            <SiteFooter locale={locale} />
          </>
        )
      }
    </div>
    <CookieConsent locale={locale} />
  </body>
</html>
