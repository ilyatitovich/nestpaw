{
  "name": "online-store",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @online-store/api exec prisma generate",
    "db:migrate": "pnpm --filter @online-store/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @online-store/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @online-store/api exec prisma db seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
