{
  "name": "online-store",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @online-store/api exec prisma generate",
    "db:migrate": "pnpm --filter @online-store/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @online-store/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @online-store/api exec prisma db seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
